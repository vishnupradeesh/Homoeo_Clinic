# Copy this file to .env and fill in real values to enable delivery.
# Any variable left unset means that channel is simulated (logged) instead.

# ---- Email (SMTP) ----
# Example for Gmail: use an App Password, host smtp.gmail.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Arokya Homoeo Clinic <no-reply@arokyaclinic.local>

# ---- SMS & WhatsApp (Twilio) ----
# Find SID/token in the Twilio Console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio phone number capable of SMS, e.g. +14155551234
TWILIO_SMS_FROM=
# Twilio WhatsApp sender, e.g. whatsapp:+14155238886 (sandbox) or your number
TWILIO_WHATSAPP_FROM=

# ---- App secret (JWT signing) ----
CLINIC_SECRET_KEY=change-me-in-production

# ---- Google Sign-In ----
# OAuth 2.0 Web Client ID from Google Cloud Console.
# Add both http://localhost:5173 and http://127.0.0.1:5173 as authorized
# JavaScript origins. The frontend reads this public client ID from the API.
GOOGLE_CLIENT_ID=

# ---- AI assistant (Ollama, open-source models) ----
# Install Ollama (https://ollama.com) and pull a model, e.g.:
#   ollama pull llama3.2:1b
# Leave unset to use the built-in rule-based fallback.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
CHAT_TIMEOUT=60
